# Langfuse tracing configuration template — SEPARATE environment for prompt
# iterative testing (mirror of the llm-mailroom experiments on Langfuse).
# Copy to langfuse.env and fill in real values. langfuse.env is gitignored.
#
# The keys are PROJECT-SCOPED: create a dedicated project in the Langfuse
# account (e.g. "llm-mailroom-experiments") so iterative prompt-testing runs
# stay out of the primary llm-mailroom project. Every trace is additionally
# tagged with the LANGFUSE_ENVIRONMENT value.

# Langfuse data region / self-hosted URL.
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# Fallback var name (older SDKs / self-hosted setups).
# LANGFUSE_HOST=

# Project-scoped API keys (Settings -> API keys inside the project).
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key-here
LANGFUSE_SECRET_KEY=your-langfuse-secret-key-here

# Display name of the separate project (used in experiment-log metadata).
LANGFUSE_PROJECT=llm-mailroom-experiments

# Trace-level environment tag (also the "environment" reported per run).
LANGFUSE_ENVIRONMENT=llm-mailroom-experiments
