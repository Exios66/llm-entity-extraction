# Langfuse tracing configuration — prompt-iteration experiment environment.
# Copy to config/environments/langfuse.env and fill in real values.
# langfuse.env is gitignored.
#
# ALL eval runs trace to the llm-dojo project: the keys below are
# PROJECT-SCOPED, so whatever project they belong to is where every trace
# lands — the LANGFUSE_PROJECT value is the display label riding on each
# trace. Keep both aligned on the experiment project (llm-dojo).
#
# Multi-project prompt sync: prompt iterations from src/prompts.py are
# mirrored into every project with
#   python scripts/eval/sync_langfuse_prompts.py --env-file langfuse.env \
#       --env-file langfuse-<other-project>.env
# Each --env-file carries that project's keys (create a second env file with
# the OTHER project's key pair, e.g. the primary llm-mailroom environment).

# Langfuse data region / self-hosted URL.
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# Fallback var name (older SDKs / self-hosted setups).
# LANGFUSE_HOST=

# Project-scoped API keys (Settings -> API keys inside the project).
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key-here
LANGFUSE_SECRET_KEY=your-langfuse-secret-key-here

# Display name of the project (used in experiment-log metadata).
LANGFUSE_PROJECT=llm-dojo

# Trace-level environment tag (also the "environment" reported per run).
LANGFUSE_ENVIRONMENT=llm-dojo
