# Braintrust org/project/dataset/experiment configuration template.
# Copy to config/environments/braintrust.env and fill in real values.
# braintrust.env is gitignored.

# Braintrust organization.
BRAINTRUST_ORG_ID=your-org-id-here

# Project name and ID for experiments.
BRAINTRUST_PROJECT_NAME=mailroom-eval
BRAINTRUST_PROJECT_ID=your-project-id-here

# Dataset project (usually same as above).
BRAINTRUST_DATASET_PROJECT=mailroom-eval

# Default model for experiments.
BRAINTRUST_MODEL=qwen/qwen3.7-flash

# Escalation model (optional).
# BRAINTRUST_ESCALATION_MODEL=google/gemini-2.5-pro

# API base.
BRAINTRUST_API_BASE=https://api.braintrust.dev

# API keys.
BRAINTRUST_API_KEY=your-braintrust-api-key-here
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Optional: alternate OpenRouter key for failover.
# RESEARCH_FUNDING_API_KEY=

# Optional: separate read-only key for dataset source.
# DATA_BRAINTRUST_KEY=

# Agent account overrides (optional).
# AGENT_BRAINTRUST_ORG_ID=
# AGENT_BRAINTRUST_PROJECT_ID=
# AGENT_BRAINTRUST_PROJECT_NAME=
# AGENT_BRAINTRUST_DATASET_PROJECT=
# AGENT_BRAINTRUST_DATASET=
# AGENT_BRAINTRUST_API_BASE=
# AGENT_BRAINTRUST_API_KEY=
