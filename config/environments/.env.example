# Environment variables template.
# Copy to config/environments/.env and fill in real values. .env is gitignored.

# === LLM Providers ===
# Primary: OpenRouter
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Externally-funded OpenRouter key (research funding). Accessible ONLY via the
# --research-funding-key flag on the eval runners; the production gate refuses
# dry-runs and pilot-scale samples (<100 rows, or less than the full dataset),
# so external funding pays only for fully-ready production runs.
# RESEARCH_FUNDING_OPENROUTER_API_KEY=sk-or-v1-your-funding-key-here

# === Observability ===
# Which backend to log to: auto | langfuse | braintrust | none
OBSERVABILITY_PROVIDER=auto
OBSERVABILITY_ENVIRONMENT=live

# Langfuse (optional — alternative to Braintrust for tracing).
# LANGFUSE_PUBLIC_KEY=pk-lf-xxxx
# LANGFUSE_SECRET_KEY=sk-lf-xxxx
# LANGFUSE_HOST=http://localhost:3000

# Braintrust.
BRAINTRUST_API_KEY=your-braintrust-api-key-here
BRAINTRUST_PROJECT=mailroom-eval

# Generic provider fallback.
GENERIC_API_KEY=
GENERIC_BASE_URL=

# Local providers.
OLLAMA_BASE_URL=http://localhost:11434/v1
VLLM_BASE_URL=http://localhost:8000/v1

# === Modal-deployed vLLM (KANBAN-096) — see deploy/README.md ===
# Deploy once with:  pip install -e ".[deploy]" && cd deploy && modal deploy modal_vllm.py
# then flip THIS pipeline onto it by pointing the provider seam at the printed
# *.modal.run URL. The KEY NAME stays OPENROUTER_API_KEY (the LangChain client
# was born talking OpenRouter); its VALUE becomes your MODAL_VLLM_API_TOKEN.
# Resolved at client-build time since KANBAN-096, so dotenv values work.
# OPENROUTER_BASE_URL=https://<workspace>--entity-vllm-serve.modal.run/v1
#
# Deploy-time knobs (set BEFORE `modal deploy`, not in this file):
#   MODAL_VLLM_MODEL / MODAL_VLLM_GPU / MODAL_VLLM_QUANTIZATION /
#   MODAL_VLLM_MAX_MODEL_LEN / MODAL_VLLM_API_TOKEN / HF_TOKEN
#
# Cross-repo contract: llm-mailroom speaks the SAME server through its own
# seam (DEFAULT_PROVIDER=vllm + VLLM_BASE_URL + VLLM_API_KEY), so ONE Modal
# deployment can back both pipelines. See deploy/README.md.
# VLLM_BASE_URL=https://<workspace>--entity-vllm-serve.modal.run/v1
# VLLM_API_KEY=<your MODAL_VLLM_API_TOKEN value>

# Default provider override.
DEFAULT_PROVIDER=openrouter

# LangSmith (optional — traces every LangChain LLM call to the project; the
# llm-mailroom project id is bbf45300-ca81-4126-99a0-2e02a49c2ceb; the project
# also receives OpenRouter's own OTEL export when configured on the OpenRouter
# dashboard, which is where per-provider 429/limit spans come from).
# NOTE: LANGSMITH_PROJECT is a project NAME, not an id. The LegalBench/HEARSAY
# eval project is named "HEARSAY" (project id 67d5b276-b323-4e90-95f1-e111e6fd88b9);
# setting the raw UUID here would CREATE a spurious project literally named with
# the UUID instead of routing to the intended one.
LANGSMITH_API_KEY=lsv2_pt_your-project-token-here
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=HEARSAY
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Run sink: Braintrust experiment/span logging is DISABLED by default (its
# plan's scored-run / log-byte quota is not consumed). Runs sink to Langfuse
# (run_langfuse_*_eval.py) + LangSmith (LANGSMITH_TRACING) + the repo
# experiment log; Braintrust remains read-only for dataset hosting.
# BRAINTRUST_LOGGING=disabled
BRAINTRUST_LOGGING=disabled

# === Arize Phoenix local trace sink (default, local-first) ===
# Single-process, SQLite-backed, OpenTelemetry-native; no cloud subscription,
# no quota. resolve_tracer() (src/tracing.py) traces run_langfuse_*_eval.py to
# Langfuse when its keys are configured and falls back to this local server —
# the experiment-log record reports tracing_backend = "phoenix" when it fires.
# See wiki/Phoenix-Tracing.md for the full resume/checkpoint/queue/cache story.
PHOENIX_TRACING=enabled
PHOENIX_ENDPOINT=http://localhost:6006/v1/traces
# PHOENIX_SERVICE_NAME=llm-entity-extraction
# PHOENIX_PROJECT=llm-dojo
# PHOENIX_SESSION=

# Enable LangChain OpenTelemetry instrumentation so every LLM call emits spans
# to Phoenix (OTEL_EXPORTER_OTLP_ENDPOINT may also be set to PHOENIX_ENDPOINT).
LANGCHAIN_TRACING_V2=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006/v1/traces
