# Environment variables template.
# Copy to .env and fill in real values. .env is gitignored.

# === LLM Providers ===
# Primary: OpenRouter
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# === Observability ===
# Which backend to log to: auto | langfuse | braintrust | none
OBSERVABILITY_PROVIDER=auto
OBSERVABILITY_ENVIRONMENT=live

# Langfuse (optional — alternative to Braintrust for tracing).
# LANGFUSE_PUBLIC_KEY=pk-lf-xxxx
# LANGFUSE_SECRET_KEY=sk-lf-xxxx
# LANGFUSE_HOST=http://localhost:3000

# Braintrust.
BRAINTRUST_API_KEY=your-braintrust-api-key-here
BRAINTRUST_PROJECT=mailroom-eval

# Generic provider fallback.
GENERIC_API_KEY=
GENERIC_BASE_URL=

# Local providers.
OLLAMA_BASE_URL=http://localhost:11434/v1
VLLM_BASE_URL=http://localhost:8000/v1

# Default provider override.
DEFAULT_PROVIDER=openrouter

# LangSmith (optional — traces every LangChain LLM call to the project; the
# llm-mailroom project id is bbf45300-ca81-4126-99a0-2e02a49c2ceb; the project
# also receives OpenRouter's own OTEL export when configured on the OpenRouter
# dashboard, which is where per-provider 429/limit spans come from).
LANGSMITH_API_KEY=lsv2_pt_your-project-token-here
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=67d5b276-b323-4e90-95f1-e111e6fd88b9
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Run sink: Braintrust experiment/span logging is DISABLED by default (its
# plan's scored-run / log-byte quota is not consumed). Runs sink to Langfuse
# (run_langfuse_*_eval.py) + LangSmith (LANGSMITH_TRACING) + the repo
# experiment log; Braintrust remains read-only for dataset hosting.
# BRAINTRUST_LOGGING=disabled
BRAINTRUST_LOGGING=disabled
